{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PORT",
    "NODE_ENV",
    "CLIENT_ORIGIN",
    "REDIS_URL",
    "YOUTUBE_API_KEY",
    "NEXT_PUBLIC_SERVER_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "NODE_ENV",
        "CLIENT_ORIGIN",
        "REDIS_URL",
        "YOUTUBE_API_KEY",
        "NEXT_PUBLIC_SERVER_URL"
      ]
    }
  }
}
