# Server Configuration
PORT=4000
NODE_ENV=production

# Client origin for CORS (comma-separated if multiple, e.g. http://localhost:3000,https://who.app)
CLIENT_ORIGIN=http://localhost:3000

# Redis connection URL for room state persistence (optional; falls back to in-memory)
REDIS_URL=redis://localhost:6379

# YouTube Data API v3 Key (Server-side only - NEVER expose to client)
# Obtain a key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
