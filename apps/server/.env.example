# ==============================================================================
# WHO? Backend Server Environment Configuration Reference
# ==============================================================================

# Backend HTTP & WebSocket port
PORT=4000

# Environment mode (development / production)
NODE_ENV=development

# Allowed CORS origins (comma-separated if multiple, e.g. http://localhost:3000,https://who-web.up.railway.app)
CLIENT_ORIGIN=http://localhost:3000

# Redis connection URL for room state persistence (optional; falls back to in-memory)
# Local: redis://localhost:6379
# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# YouTube Data API v3 Key (Server-side only - NEVER expose to client)
# Obtain a key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
