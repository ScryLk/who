# WHO? Monorepo Environment Configuration Reference

# Server Port
PORT=4000
NODE_ENV=production

# Client origin for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:3000

# Redis connection URL for room state persistence (optional; falls back to in-memory)
REDIS_URL=redis://localhost:6379

# YouTube Data API v3 Key (Server-side only - NEVER commit or expose to client)
# Obtain a key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Web App Configuration (Next.js public URL)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
