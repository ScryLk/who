# ==============================================================================
# WHO? Monorepo Environment Configuration Reference
# ==============================================================================
# This file documents all environment variables used across the WHO? monorepo
# for both local development and production deployments (e.g. Railway).
#
# IMPORTANT:
# - NEVER commit real credentials or .env files to version control.
# - In Docker/Railway, NEXT_PUBLIC_SERVER_URL must be provided as a build argument
#   so Next.js can inline it into client bundles at build time.
# - Secrets (YOUTUBE_API_KEY, REDIS_URL) must strictly remain runtime variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT CONFIGURATION (Default)
# ------------------------------------------------------------------------------
# Backend HTTP & WebSocket server port
PORT=4000

# Environment mode (development / production)
NODE_ENV=development

# Allowed CORS origins for Express and Socket.IO (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:3000

# Optional Redis connection URL for room state persistence.
# If omitted or unavailable, the server automatically uses in-memory fallback.
REDIS_URL=redis://localhost:6379

# Google YouTube Data API v3 Key (Server-side secret only)
# Required for YouTube catalog search. Leave blank to use preview tracks only.
YOUTUBE_API_KEY=

# Public backend URL for client-side Socket.IO and REST requests.
# Used by Next.js client components in apps/web.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. RAILWAY PRODUCTION CONFIGURATION REFERENCE
# ------------------------------------------------------------------------------
# On Railway, your deployment uses two public domains:
#   - Frontend (Web):  https://who-web.up.railway.app  (Port 3000)
#   - Backend (API):   https://who-api.up.railway.app  (Port 4000)
#
# Variables for WHO APP Service on Railway:
#
# NODE_ENV=production
# PORT=4000
# CLIENT_ORIGIN=https://who-web.up.railway.app
# REDIS_URL=${{Redis.REDIS_URL}}
# YOUTUBE_API_KEY=your_production_google_api_key
#
# Build Arguments for WHO APP Service:
# NEXT_PUBLIC_SERVER_URL=https://who-api.up.railway.app
# ------------------------------------------------------------------------------
